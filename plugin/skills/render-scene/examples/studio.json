{
  // Pastel studio: a seamless backdrop where the floor melts into the background (4 s loop).
  // Tested values: the ground renders lighter than its hex, so it's set darker than the sky to match it.
  // Keep the sun, ambient, sky and ground together; changing one of them shows the horizon line again.
  "version": 1,
  "output": { "width": 1080, "height": 1350, "fps": 30, "duration": 4 },
  "environment": {
    "sky": "#f8e1e8",
    "ground": "#f0d1d5",
    "ambient": 0.5
  },
  "materials": {
    "pedestal": { "color": "#fff4f6", "roughness": 0.7 },
    "lilac":    { "color": "#b9a2ff", "roughness": 0.25 },
    "peach":    { "color": "#ffb4a2", "roughness": 0.5 },
    "mint":     { "color": "#9fe3cf", "roughness": 0.6 },
    "butter":   { "color": "#ffe08a", "roughness": 0.5 }
  },
  "objects": [
    { "id": "pedestal", "mesh": "roundbox", "bevel": 0.12, "pivot": "bottom", "material": "pedestal", "scale": [1.3, 1.3, 0.35] },
    { "id": "gem",   "mesh": "gem", "material": "lilac", "position": [0, 0, 0.8], "scale": [0.55, 0.55, 0.6] },
    { "id": "donut", "mesh": "torus", "pivot": "bottom", "material": "peach", "position": [0.45, -1.05, 0], "rotation": [0, 30, 0], "scale": 0.75 },
    { "id": "pebble", "mesh": "rock", "seed": 4, "pivot": "bottom", "material": "mint", "position": [-0.6, -1.0, 0], "scale": [0.55, 0.45, 0.35] },
    { "id": "bead",  "mesh": "sphere", "flat": true, "pivot": "bottom", "material": "butter", "position": [0.95, 0.75, 0], "scale": 0.3 },
    { "id": "sun", "light": { "type": "directional", "intensity": 1.1 }, "position": [4, -5, 7], "lookAt": [0, 0, 0] },
    { "id": "cam", "camera": {}, "position": [1.9, -1.45, 1.15], "lookAt": [0, -0.3, 0.5] }
  ],
  "animations": [
    // The gem floats and turns; 90 deg/s and a 2 s bob both loop in 4 s
    { "target": "gem.rotation", "spin": [0, 90, 0] },
    { "target": "gem.position.z", "wave": { "amplitude": 0.06, "period": 2 } },
    { "target": "cam.position.y", "keys": [[0, -1.45], [2, -1.2], [4, -1.45]], "ease": "inOutSine" }
  ]
}
