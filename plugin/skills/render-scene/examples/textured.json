{
  // A glTF model with a texture: assets/crate.gltf is a 1 m wooden cube modeled resting on its origin,
  // so position z = 0 puts it on the floor. Scale and turn it like any mesh.
  "version": 1,
  "output": { "width": 1080, "height": 1080 },
  "environment": {
    "sky": ["#a8c8ff", "#fff0e0", "#f2e2d2"],
    "ground": "#eadacb"
  },
  "objects": [
    { "id": "crate1", "mesh": "assets/crate.gltf", "position": [0, 0, 0], "rotation": [0, 15, 0] },
    { "id": "crate2", "mesh": "assets/crate.gltf", "position": [0.1, 0.05, 1.0], "rotation": [0, -10, 0], "scale": 0.7 },
    { "id": "crate3", "mesh": "assets/crate.gltf", "position": [0.2, -1.25, 0], "rotation": [0, 40, 0], "scale": 0.8 },
    // "color" replaces the model's own material (texture included) with a plain one
    { "id": "painted", "mesh": "assets/crate.gltf", "color": "#5d8bff", "position": [0.9, 1.0, 0], "rotation": [0, 20, 0], "scale": 0.5 },
    { "id": "sun", "light": { "type": "directional" }, "position": [-3, -5, 6], "lookAt": [0, 0, 0] },
    { "id": "cam", "camera": {}, "position": [2.6, -1.3, 1.6], "lookAt": [0, -0.1, 0.6] }
  ]
}
