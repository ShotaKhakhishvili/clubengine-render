{
  // A looping bounce with squash and stretch (2 s loop)
  "version": 1,
  "output": { "width": 1080, "height": 1350, "fps": 30, "duration": 2 },
  "environment": {
    "sky": ["#ffd1e8", "#fff1e6", "#ffe3ef"],
    "ground": "#ffe0ec"
  },
  "objects": [
    // pivot "bottom": the ball's origin is its lowest point, so the squash keeps it on the floor
    { "id": "ball", "mesh": "sphere", "pivot": "bottom", "color": "#ff4f8b", "position": [0, 0, 0] },
    { "id": "sun", "light": { "type": "directional", "intensity": 1.2 }, "position": [-2, -5, 7], "lookAt": [0, 0, 0] },
    { "id": "cam", "camera": {}, "position": [-3.2, -1.4, 1.5], "lookAt": [0, 0, 1.35] }
  ],
  "animations": [
    // One hop per 2 s, slow at the top and fast at the ground; squashes on impact, stretches while fast
    { "target": "ball.position.z", "bounce": { "height": 2.1, "period": 2, "squash": 0.22 } },
    // The camera drifts a little so it feels alive
    { "target": "cam.position.y", "keys": [[0, -1.4], [1, -1.1], [2, -1.4]], "ease": "inOutSine" }
  ]
}
