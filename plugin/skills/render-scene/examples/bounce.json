{
  // A looping bounce with squash and stretch (2 s loop)
  "version": 1,
  "output": { "width": 1080, "height": 1350, "fps": 30, "duration": 2 },
  "environment": {
    "sky": ["#ffd1e8", "#fff1e6", "#ffe3ef"],
    "ground": "#ffe0ec"
  },
  "objects": [
    { "id": "ball", "mesh": "sphere", "color": "#ff4f8b", "position": [0, 0, 0.5] },
    { "id": "sun", "light": { "type": "directional", "intensity": 1.2 }, "position": [-2, -5, 7], "lookAt": [0, 0, 0] },
    { "id": "cam", "camera": {}, "position": [-3.2, -1.4, 1.5], "lookAt": [0, 0, 1.35] }
  ],
  "animations": [
    // Up and down: slow at the top, fast at the ground
    { "target": "ball.position.z", "keys": [[0, 0.42], [0.1, 0.5, "outQuad"], [1.0, 2.6, "inQuad"], [1.9, 0.5, "linear"], [2.0, 0.42]] },
    // Squash on impact, stretch while moving fast, round at the top
    { "target": "ball.scale", "keys": [
        [0.0, [1.25, 1.25, 0.8]], [0.12, [0.9, 0.9, 1.2]], [0.35, [1, 1, 1]],
        [1.65, [1, 1, 1]], [1.88, [0.9, 0.9, 1.2]], [2.0, [1.25, 1.25, 0.8]] ], "ease": "inOutSine" },
    // The camera drifts a little so it feels alive
    { "target": "cam.position.y", "keys": [[0, -1.4], [1, -1.1], [2, -1.4]], "ease": "inOutSine" }
  ]
}
